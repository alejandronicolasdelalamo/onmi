# Copia este archivo a .env y ajusta los valores.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# SQLite por defecto en local. En Docker/producción usa Postgres:
# DATABASE_URL=postgresql://onmi:onmi@db:5432/onmi
FRONTEND_URL=http://localhost:5173

# Email (opcional). Sin SENDGRID_API_KEY los correos se imprimen en consola.
SENDGRID_API_KEY=
MAIL_FROM=no-reply@onmi.app

# Login con Google (opcional). Sin client id el botón se oculta.
GOOGLE_CLIENT_ID=

# Modo demo (botón "Try demo")
DEMO_ENABLED=true

# Recordatorios push (opcional). Genera el par con:  flask --app wsgi generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# Coach semanal con IA (opcional). Sin clave se usa siempre el redactor local. Cada usuario debe activarlo en Ajustes.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
