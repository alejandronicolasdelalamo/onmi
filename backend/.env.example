# Copia este archivo a .env y ajusta los valores.
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# SQLite por defecto en local. En Docker/producción usa Postgres:
# DATABASE_URL=postgresql://onmi:onmi@db:5432/onmi
FRONTEND_URL=http://localhost:5173

# Email (opcional). Sin SENDGRID_API_KEY los correos se imprimen en consola.
SENDGRID_API_KEY=
MAIL_FROM=no-reply@onmi.app

# Login con Google (opcional). Sin client id el botón se oculta.
GOOGLE_CLIENT_ID=

# Modo demo (botón "Try demo")
DEMO_ENABLED=true
