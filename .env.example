# Variables para `docker compose up`. Copia a `.env` y cambia los secretos.
# Genera uno válido con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
POSTGRES_PASSWORD=onmi

# URL pública de la app (se usa en los enlaces de los correos).
FRONTEND_URL=http://localhost:8000

# Opcionales
SENDGRID_API_KEY=
MAIL_FROM=no-reply@onmi.app
GOOGLE_CLIENT_ID=
DEMO_ENABLED=true
COOKIE_SECURE=true

# Recordatorios push (opcional). Genera el par con:  flask --app wsgi generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# Coach semanal con IA (opcional). Sin clave se usa siempre el redactor local. Cada usuario debe activarlo en Ajustes.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
